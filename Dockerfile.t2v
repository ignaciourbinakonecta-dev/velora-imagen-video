# Velora Video T2V: ComfyUI API + Wan 2.2 T2V 14B (texto a video, fp8) horneados + post-proceso (RIFE, RealESRGAN).
# Mismo diseño que la imagen I2V (Dockerfile.base + Dockerfile), pero con los modelos de TEXTO a video: el clip
# sale directo del texto de la toma, sin keyframe. El LoRA de video del personaje se entrenó sobre Wan 2.2 T2V.
# Salad no cobra mientras baja la imagen. Al encender solo se bajan: umt5 (6,3 GB) y LightX2V T2V alto (1,2 GB).
FROM ghcr.io/saladtechnologies/comfyui-api:comfy0.35.0-api1.19.2-torch2.13.0-cuda13.0-runtime
LABEL org.opencontainers.image.source="https://github.com/ignaciourbinakonecta-dev/velora-imagen-video"
LABEL org.opencontainers.image.description="Velora Video T2V - ComfyUI + Wan 2.2 T2V 14B fp8 + RIFE (Apache 2.0)"

COPY bajar.py /tmp/bajar.py
# una capa por modelo grande
RUN python3 /tmp/bajar.py \
    https://huggingface.co/Comfy-Org/Wan-2.2/resolve/main/split_files/diffusion_models/wan2.2_t2v_high_noise_14B_fp8_scaled.safetensors \
    /opt/ComfyUI/models/diffusion_models/wan2.2_t2v_high_noise_14B_fp8_scaled.safetensors
RUN python3 /tmp/bajar.py \
    https://huggingface.co/Comfy-Org/Wan-2.2/resolve/main/split_files/diffusion_models/wan2.2_t2v_low_noise_14B_fp8_scaled.safetensors \
    /opt/ComfyUI/models/diffusion_models/wan2.2_t2v_low_noise_14B_fp8_scaled.safetensors
RUN python3 /tmp/bajar.py \
    https://huggingface.co/Comfy-Org/Wan-2.1/resolve/main/split_files/vae/wan_2.1_vae.safetensors \
    /opt/ComfyUI/models/vae/wan_2.1_vae.safetensors && \
    python3 /tmp/bajar.py \
    https://huggingface.co/Comfy-Org/Wan-2.2/resolve/main/split_files/loras/wan2.2_t2v_lightx2v_4steps_lora_v1.1_low_noise.safetensors \
    /opt/ComfyUI/models/loras/wan2.2_t2v_lightx2v_4steps_lora_v1.1_low_noise.safetensors

# post-proceso: RIFE 4.7 (16 -> 32 fps) y RealESRGAN anime (igual que la imagen v2)
ARG FI_SHA=26545cc2dd95bc3d27f056016300673bdeee78f5
RUN python3 /tmp/bajar.py \
      https://github.com/Fannovel16/ComfyUI-Frame-Interpolation/archive/${FI_SHA}.zip /tmp/fi/fi.zip && \
    python3 -c "import zipfile; zipfile.ZipFile('/tmp/fi/fi.zip').extractall('/tmp/fi')" && \
    mv /tmp/fi/ComfyUI-Frame-Interpolation-${FI_SHA} /opt/ComfyUI/custom_nodes/ComfyUI-Frame-Interpolation && \
    rm -rf /tmp/fi && \
    python3 -m pip install --no-cache-dir einops kornia scipy opencv-contrib-python-headless && \
    python3 /tmp/bajar.py https://huggingface.co/marduk191/rife/resolve/main/rife47.pth \
      /opt/ComfyUI/custom_nodes/ComfyUI-Frame-Interpolation/ckpts/rife/rife47.pth && \
    python3 /tmp/bajar.py \
      https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.2.4/RealESRGAN_x4plus_anime_6B.pth \
      /opt/ComfyUI/models/upscale_models/RealESRGAN_x4plus_anime_6B.pth && \
    python3 -c "import einops, kornia, scipy, cv2; print('deps OK', cv2.__version__)"

# nodo propio: sube cada clip terminado a Hugging Face (evita el límite de 100 s del gateway de Salad)
COPY velora_nodo.py /opt/ComfyUI/custom_nodes/velora_comfy_nodes/__init__.py
